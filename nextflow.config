// nextflow.config
// ONT long-read T2T de novo assembly pipeline
// Singularity or Conda, single-machine/local executor.

nextflow.enable.dsl = 2

manifest {
    name            = 'TTTAssembly'
    description     = 'ONT SQK-ULK114 telomere-to-telomere de novo assembly'
    author          = 'Muhammad Irfan'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}

// ---------------------------------------------------------------------------
// Parameters 
// ---------------------------------------------------------------------------
params {
    // mode / identity
    mode          = 'expert'      // 'expert' (Verkko) | 'scalable' (hifiasm)
    sample        = 'sample'

    // inputs
    ulk_reads     = null          // ULK BAM (required, expert mode)
    porec_reads   = null          // Pore-C BAM  (Pore-C branch)
    hic_reads_1   = null          // Hi-C R1 FASTQ (Hi-C branch; shared with scalable mode)
    hic_reads_2   = null          // Hi-C R2 FASTQ (Hi-C branch; shared with scalable mode)

    // inputs — scalable mode only (see CLAUDE.md §11)
    long_reads    = null          // ONT long reads: .bam/.fastq/.fastq.gz, comma-separated (required, scalable mode)
    mat_reads     = null          // maternal reads for trio phasing (via yak)
    pat_reads     = null          // paternal reads for trio phasing (via yak)
    telo_motif    = 'CCCTAA'      // telomere motif for `hifiasm --telo-m` (human/vertebrate default)

    // output
    output        = 'results'

    // provisioning
    images_dir    = "${projectDir}/images"  // built .sif files (-profile singularity); override to
                                             // point at a shared/pre-built images dir instead of
                                             // this checkout's own gitignored images/

    // behaviour
    filtering     = true          // true -> apply qs/length filter; false -> plain BAM->FASTQ
    min_qs        = 10            // filter: mean read qscore, ULK only (Pore-C has no qscore filter)
    min_len_ulk   = 10000         // filter: read length (bp), ULK
    min_len_porec = 500           // filter: read length (bp), Pore-C (length-only, no qscore filter)
    plot          = false         // seqkit stats always runs; NanoPlot only runs when --plot is set

    // compute
    threads       = 48             // default CPUs per process
    max_memory_gb = null          // -> Verkko --local-memory (required, expert mode)
    dorado_device = 'cuda:0'      // -> dorado correct -x
    dorado_path   = null          // override path to the dorado binary; defaults to 'dorado' on PATH

    help          = false
}

// ---------------------------------------------------------------------------
// Standalone assembly-QC workflow (assembly_qc.nf) — separate from the pipeline above; see
// CLAUDE.md §10. Kept in its own params block for a clean separation from the assembly-pipeline
// params, though Nextflow merges all params{} blocks in one config the same way — which is
// exactly why --output/--sample are NOT redeclared here: they're already defaulted above
// ('results'/'sample') for the main pipeline, and a second default for the same key in this
// block would silently win for BOTH entry scripts (Nextflow evaluates every params{} block in
// the file regardless of which script you run), overriding main.nf's default too. The doc
// proposed 'assembly_qc'/'assembly' as this workflow's defaults; pass --output/--sample
// explicitly on the CLI to get that instead of the inherited 'results'/'sample'.
// ---------------------------------------------------------------------------
params {
    // inputs
    assembly      = null          // Required. Primary/combined assembly FASTA.
    assembly_H1   = null          // Optional haplotype 1 FASTA.
    assembly_H2   = null          // Optional haplotype 2 FASTA.
    reads         = null          // Reads for the meryl k-mer DB (quoted glob). Required for merqury/merfin.

    // behaviour
    tools         = 'gfastats,seqtk,compleasm'   // comma-separated subset, or 'none'
    genome_size   = 3100000000    // haploid expected size (bp) — gfastats NGx, QUAST --est-ref-size, GenomeScope2
    ploidy        = 2             // 1 = bacteria/haploid, 2 = diploid — GenomeScope2/Merfin

    // tool-specific
    meryl_k             = 21          // k-mer size for meryl/Merqury/Merfin
    merfin_peak         = null        // homozygous k-mer coverage peak for Merfin; required if --tools includes merfin
    compleasm_lineage   = 'primates'
    compleasm_downloads = null        // optional pre-downloaded lineage dir (-L); enables offline compleasm
    quast_reference     = null        // optional reference FASTA; default = reference-free QUAST
    quast_large         = null        // true/false to force QUAST --large; null = auto by genome_size
}

// ---------------------------------------------------------------------------
// Process resources AND engine execution (container/conda), all selected by label, all in this
// ONE process{} block — labels are set once in each process definition (modules/local/*.nf) and
// survive however a process is aliased in a workflow (e.g. BAM_TO_FASTQ_ULK/_POREC in
// workflows/expert.nf), so this doesn't need updating when a process gets a new
// `include { X as Y }` alias. See CLAUDE.md §5 for each process's label(s).
//
// `container` and `conda` are both set on every withLabel block, unconditionally — this is safe
// and is the reason there's only one process{} block in this whole file: Nextflow only consults
// `container` when `singularity.enabled` (or `docker.enabled`) is true, and only consults `conda`
// when `conda.enabled` is true, so whichever one the active profile turns on is the only one that
// actually applies; the other sits inert. The `profiles {}` block below therefore only flips
// those two engine-enabled flags — it declares no per-label directives of its own, and there is
// no other process{} scope anywhere in this file for a withLabel selector to be split across.
// (An earlier version had `container`/`conda` set inside separate `profiles { singularity {
// process {...} } }` / `profiles { conda { process {...} } }` blocks, each redeclaring the same
// withLabel selectors as this block — multiple `process{}` scopes, all setting the *same*
// `withLabel: 'x'` selector for different directives, spread across the file. Consolidated into
// this single block after that structure produced fallback-to-Nextflow's-built-in-default (1)
// cpu/memory behavior in practice — root cause not conclusively pinned down (see
// sessions/session.md), but there is no longer more than one process{} scope in this file for
// this to happen to.)
//
// No generic/bare `cpus` or `memory` on the bare `process {}` scope either, for the same reason:
// every label below sets its own value directly, so there's no competing bare directive.
// ---------------------------------------------------------------------------
process {
    errorStrategy = 'terminate'

    withLabel: 'samtools' {
        cpus    = { Math.min(params.threads as int, 48) }
        memory  = 8.GB
        container = "${params.images_dir}/samtools.sif"
        conda     = "${projectDir}/conda/samtools.yml"
    }

    withLabel: 'qc' {
        cpus    = { Math.min(params.threads as int, 4) }
        memory  = 8.GB
        container = "${params.images_dir}/qc.sif"
        conda     = "${projectDir}/conda/qc.yml"
    }

    withLabel: 'dorado' {
        cpus    = { Math.min(params.threads as int, 48) }  // dorado uses CPUs for the overlap step
        memory  = 64.GB
        container = "${params.images_dir}/dorado.sif"
        // No `conda` here — Dorado has no conda/bioconda package. Under -profile conda,
        // DORADO_CORRECT/DORADO_VERSION get no `conda` directive and just run against whatever
        // `dorado` binary is already on PATH; install it manually (see README.md "Alternative:
        // Conda").
    }

    withLabel: 'gpu' {
        containerOptions = '--nv'  // Singularity's GPU passthrough flag; no-op under -profile conda
    }

    withLabel: 'verkko' {
        // --threads is meant for the assembler: task.cpus here is params.threads directly (no
        // multiplier), and modules/local/verkko.nf passes it straight through to --local-cpus.
        // executor.cpus (below) raises the local executor's own cpu ceiling to match, so this
        // doesn't get silently capped back down if the host's auto-detected processor count is
        // lower than --threads.
        cpus    = { params.threads }
        // Verkko is memory-hungry; --local-memory (params.max_memory_gb) is the real cap.
        memory  = { (params.max_memory_gb ? "${params.max_memory_gb} GB" : '64 GB') }
        container = "${params.images_dir}/verkko.sif"
        conda     = "${projectDir}/conda/verkko.yml"
    }

    // Scalable mode (hifiasm-based assembly, see CLAUDE.md §11). Same reasoning as 'verkko'
    // above: task.cpus is params.threads directly — see the 'verkko' comment.
    withLabel: 'hifiasm' {
        cpus    = { params.threads }
        memory  = 480.GB  // ONT: >=300 GB for a human genome
        container = "${params.images_dir}/hifiasm.sif"
        conda     = "${projectDir}/conda/hifiasm.yml"
    }

    // 'yak' (YAK_COUNT, trio only) — lightweight k-mer counting on one parent's reads, so it
    // gets a modest explicit cap rather than the full --threads.
    withLabel: 'yak' {
        cpus    = { Math.min(params.threads as int, 48) }
        memory  = 8.GB
        container = "${params.images_dir}/yak.sif"
        conda     = "${projectDir}/conda/yak.yml"
    }

    // Tool-version capture processes (SAMTOOLS_VERSION, QC_VERSIONS, DORADO_VERSION,
    // VERKKO_VERSION, SOFTWARE_VERSIONS) carry both their tool's label and 'quick' — declared
    // last so it overrides the heavier per-tool cpus/memory set above for just these processes.
    // (container/conda still come from the tool's own label — 'quick' doesn't set either.)
    withLabel: 'quick' {
        cpus   = 1
        memory = 1.GB
    }

    // Standalone assembly-QC workflow (assembly_qc.nf, see CLAUDE.md §10) — conda-only for now,
    // no `.def` recipes / `container` entries exist for these yet, and no cpus/memory tuning
    // either (deferred — see CLAUDE.md §10 "Open questions").
    withLabel: 'gfastats'     { conda = "${projectDir}/conda/gfastats.yml" }
    withLabel: 'seqtk'        { conda = "${projectDir}/conda/seqtk.yml" }
    withLabel: 'compleasm'    { conda = "${projectDir}/conda/compleasm.yml" }
    withLabel: 'quast'        { conda = "${projectDir}/conda/quast.yml" }
    withLabel: 'meryl'        { conda = "${projectDir}/conda/meryl.yml" }
    withLabel: 'merqury'      { conda = "${projectDir}/conda/merqury.yml" }
    withLabel: 'genomescope2' { conda = "${projectDir}/conda/genomescope2.yml" }
    withLabel: 'merfin'       { conda = "${projectDir}/conda/merfin.yml" }
}

// ---------------------------------------------------------------------------
// Local executor capacity override. Nextflow's local executor auto-detects the host's available
// processors (JVM Runtime.availableProcessors(), which follows the launching process's own
// cgroup CPU quota, not necessarily the full node — e.g. an interactive login-node shell can be
// throttled to just 1-2 cores even on a big multi-core host) and silently caps any task's `cpus`
// directive down to that ceiling. VERKKO/HIFIASM request `params.threads` directly (see the
// 'verkko'/'hifiasm' labels above) — raise the ceiling here to match so it isn't capped back
// down. `executor.cpus` is the correct key for this (flat, top-level scope) — NOT nested as
// `executor { $local { cpus = ... } } }`, which Nextflow silently ignores with
// `WARN: Unrecognized config option 'executor.$local.cpus'` (the `$name` nesting is only valid
// for a handful of other executor options like queueSize/pollInterval, not cpus/memory).
// ---------------------------------------------------------------------------
executor.cpus = params.threads

// sensible default if no executor profile chosen
process.executor = 'local'

// ---------------------------------------------------------------------------
// Profiles — engine selection only. No per-label directives here: container/conda for every
// label live in the single process{} block above (see the comment there for why); a profile only
// flips which one of the two actually gets consulted, plus any other engine-wide settings.
// ---------------------------------------------------------------------------
profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // GPU access for Dorado is added via the 'gpu' label above.
    }

    conda {
        conda.enabled = true
    }

    local {
        process.executor = 'local'
    }

    // Scaffolding for nf-test (see tests/ and nf-test.config) — small resource ceilings
    // suitable for CI runners. No stub fixtures are bundled yet; see README.md "Testing".
    test {
        singularity.enabled    = true
        singularity.autoMounts = true
        params.threads = 2
    }
}

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------
timeline { enabled = true; file = "${params.output}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.output}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.output}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.output}/pipeline_info/dag.html";      overwrite = true }

