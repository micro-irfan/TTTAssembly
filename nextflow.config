// nextflow.config
// ONT long-read T2T de novo assembly pipeline
// Singularity, single-machine/local executor.

nextflow.enable.dsl = 2

manifest {
    name            = 'ont-t2t-assembly'
    description     = 'ONT SQK-ULK114 telomere-to-telomere de novo assembly (Verkko)'
    author          = ''
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

// ---------------------------------------------------------------------------
// Parameters (see CLAUDE.md §3 for the full table)
// ---------------------------------------------------------------------------
params {
    // mode / identity
    mode          = 'expert'      // 'expert' | 'scalable' (scalable = stub for now)
    sample        = 'sample'

    // inputs
    ulk_reads     = null          // ULK BAM (required, expert mode)
    porec_reads   = null          // Pore-C BAM  (Pore-C branch)
    hic_reads_1   = null          // Hi-C R1 FASTQ (Hi-C branch)
    hic_reads_2   = null          // Hi-C R2 FASTQ (Hi-C branch)

    // output
    output        = 'results'

    // behaviour
    filtering     = true          // true -> apply qs/length filter; false -> plain BAM->FASTQ
    min_qs        = 10            // filter: mean read qscore (both ULK and Pore-C)
    min_len_ulk   = 10000         // filter: read length (bp), ULK
    min_len_porec = 1000          // filter: read length (bp), Pore-C
    plot          = false         // seqkit stats always runs; NanoPlot only runs when --plot is set

    // compute
    threads       = 8             // default CPUs per process
    max_memory_gb = null          // -> Verkko --local-memory (required, expert mode)
    dorado_device = 'cuda:0'      // -> dorado correct -x

    help          = false
}

// ---------------------------------------------------------------------------
// Container images. Built from the recipes under ./singularity (see CLAUDE.md §7 and
// README.md "Building the Singularity/Apptainer images") into ./images (gitignored — these
// are large local build artifacts, not checked in). Paths are relative to the pipeline's own
// directory (projectDir) so this works regardless of the launch directory.
// ---------------------------------------------------------------------------
process {
    // default resources
    cpus   = { params.threads }
    memory = { 16.GB * task.attempt }
    errorStrategy = 'terminate'

    withName: 'BAM_TO_FASTQ' {
        container = "${projectDir}/images/samtools.sif"
        cpus      = { params.threads }
        memory    = { 8.GB }
    }

    // Merges multiple per-flowcell BAM/FASTQ inputs before BAM_TO_FASTQ / Verkko; reuses the
    // samtools image (samtools merge for BAM, plain cat for FASTQ/FASTQ.GZ) — no new image.
    withName: 'MERGE_READS' {
        container = "${projectDir}/images/samtools.sif"
        cpus      = { params.threads }
        memory    = { 8.GB }
    }

    withName: 'SEQKIT_STATS|NANOPLOT' {
        container = "${projectDir}/images/qc.sif"
        cpus      = { Math.min(params.threads as int, 4) }
        memory    = { 8.GB }
    }

    withName: 'DORADO_CORRECT' {
        container        = "${projectDir}/images/dorado.sif"
        containerOptions = '--nv'              // Singularity's GPU passthrough flag
        cpus             = { params.threads }  // dorado uses CPUs for the overlap step
        memory           = { 64.GB }
    }

    withName: 'VERKKO' {
        container = "${projectDir}/images/verkko.sif"
        cpus      = { params.threads }
        // Verkko is memory-hungry; --local-memory (params.max_memory_gb) is the real cap.
        memory    = { (params.max_memory_gb ? "${params.max_memory_gb} GB" : '64 GB') }
    }

    // withName: 'HIFIASM' { container = "${projectDir}/images/hifiasm.sif" }  // scalable mode, later

    // --- Tool-version capture (each reuses its real process's container; see CLAUDE.md §5) ---
    withName: 'SAMTOOLS_VERSION' {
        container = "${projectDir}/images/samtools.sif"
        cpus      = 1
        memory    = { 1.GB }
    }

    withName: 'QC_VERSIONS' {
        container = "${projectDir}/images/qc.sif"
        cpus      = 1
        memory    = { 1.GB }
    }

    withName: 'DORADO_VERSION' {
        container = "${projectDir}/images/dorado.sif"      // no --nv: version check doesn't need a GPU
        cpus      = 1
        memory    = { 1.GB }
    }

    withName: 'VERKKO_VERSION' {
        container = "${projectDir}/images/verkko.sif"
        cpus      = 1
        memory    = { 1.GB }
    }

    withName: 'SOFTWARE_VERSIONS' {
        container = "${projectDir}/images/qc.sif"
        cpus      = 1
        memory    = { 1.GB }
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // GPU access for Dorado is added per-process via containerOptions above.
    }

    local {
        process.executor = 'local'
    }

    // Scaffolding for nf-test (see tests/ and nf-test.config) — small resource ceilings
    // suitable for CI runners. No stub fixtures are bundled yet; see README.md "Testing".
    test {
        singularity.enabled    = true
        singularity.autoMounts = true
        params.threads = 2
    }
}

// sensible defaults if no executor profile chosen
process.executor = 'local'

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------
timeline { enabled = true; file = "${params.output}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.output}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.output}/pipeline_info/trace.txt";      overwrite = true }
dag      { enabled = true; file = "${params.output}/pipeline_info/dag.html";       overwrite = true }
