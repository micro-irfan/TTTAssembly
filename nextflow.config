// nextflow.config
// ONT long-read T2T de novo assembly pipeline
// Singularity or Conda, single-machine/local executor.

nextflow.enable.dsl = 2

manifest {
    name            = 'ont-t2t-assembly'
    description     = 'ONT SQK-ULK114 telomere-to-telomere de novo assembly (Verkko)'
    author          = ''
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

// ---------------------------------------------------------------------------
// Parameters (see CLAUDE.md §3 for the full table)
// ---------------------------------------------------------------------------
params {
    // mode / identity
    mode          = 'expert'      // 'expert' | 'scalable' (scalable = stub for now)
    sample        = 'sample'

    // inputs
    ulk_reads     = null          // ULK BAM (required, expert mode)
    porec_reads   = null          // Pore-C BAM  (Pore-C branch)
    hic_reads_1   = null          // Hi-C R1 FASTQ (Hi-C branch)
    hic_reads_2   = null          // Hi-C R2 FASTQ (Hi-C branch)

    // output
    output        = 'results'

    // behaviour
    filtering     = true          // true -> apply qs/length filter; false -> plain BAM->FASTQ
    min_qs        = 10            // filter: mean read qscore, ULK only (Pore-C has no qscore filter)
    min_len_ulk   = 10000         // filter: read length (bp), ULK
    min_len_porec = 500           // filter: read length (bp), Pore-C (length-only, no qscore filter)
    plot          = false         // seqkit stats always runs; NanoPlot only runs when --plot is set

    // compute
    threads       = 8             // default CPUs per process
    max_memory_gb = null          // -> Verkko --local-memory (required, expert mode)
    dorado_device = 'cuda:0'      // -> dorado correct -x
    dorado_path   = null          // override path to the dorado binary; defaults to 'dorado' on PATH

    help          = false
}

// ---------------------------------------------------------------------------
// Process resources (shared across engines), selected by label rather than process name —
// labels are set once in each process definition (modules/local/*.nf) and survive however a
// process is aliased in a workflow (e.g. BAM_TO_FASTQ_ULK/_POREC in workflows/expert.nf), so
// this doesn't need updating when a process gets a new `include { X as Y }` alias. Engine-
// specific execution (`container` under -profile singularity, `conda` under -profile conda) is
// set per profile below, also by label. See CLAUDE.md §5 for each process's label(s).
// ---------------------------------------------------------------------------
process {
    // default resources
    cpus   = { params.threads }
    memory = { 16.GB * task.attempt }
    errorStrategy = 'terminate'

    withLabel: 'samtools' {
        cpus   = { params.threads }
        memory = { 8.GB }
    }

    withLabel: 'qc' {
        cpus   = { Math.min(params.threads as int, 4) }
        memory = { 8.GB }
    }

    withLabel: 'dorado' {
        cpus   = { params.threads }  // dorado uses CPUs for the overlap step
        memory = { 64.GB }
    }

    withLabel: 'gpu' {
        containerOptions = '--nv'  // Singularity's GPU passthrough flag; no-op under -profile conda
    }

    withLabel: 'verkko' {
        cpus   = { params.threads * 2 }
        // Verkko is memory-hungry; --local-memory (params.max_memory_gb) is the real cap.
        memory = { (params.max_memory_gb ? "${params.max_memory_gb} GB" : '64 GB') }
    }

    // withLabel: 'hifiasm' { ... }  // scalable mode, later

    // Tool-version capture processes (SAMTOOLS_VERSION, QC_VERSIONS, DORADO_VERSION,
    // VERKKO_VERSION, SOFTWARE_VERSIONS) carry both their tool's label and 'quick' — declared
    // last so it overrides the heavier per-tool cpus/memory set above for just these processes.
    withLabel: 'quick' {
        cpus   = 1
        memory = { 1.GB }
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // GPU access for Dorado is added via the 'gpu' label above.

        // Images built from ./singularity (see CLAUDE.md §7 / README.md "Build the container
        // images") into ./images (gitignored — large local build artifacts, not checked in).
        // Paths are relative to the pipeline's own directory (projectDir).
        process {
            withLabel: 'samtools' { container = "${projectDir}/images/samtools.sif" }
            withLabel: 'qc'       { container = "${projectDir}/images/qc.sif" }
            withLabel: 'dorado'   { container = "${projectDir}/images/dorado.sif" }
            withLabel: 'verkko'   { container = "${projectDir}/images/verkko.sif" }
        }
    }

    conda {
        conda.enabled = true

        // Environment YAMLs under ./conda (see README.md "Alternative: Conda" for setup).
        // Dorado has no conda/bioconda package — no withLabel: 'dorado' entry here, so
        // DORADO_CORRECT and DORADO_VERSION get no `conda` directive and just run against
        // whatever `dorado` binary is already on PATH; install it manually first (same ONT
        // binary the Singularity image downloads — see singularity/dorado/dorado.def for the
        // exact URL/version).
        process {
            withLabel: 'samtools' { conda = "${projectDir}/conda/samtools.yml" }
            withLabel: 'qc'       { conda = "${projectDir}/conda/qc.yml" }
            withLabel: 'verkko'   { conda = "${projectDir}/conda/verkko.yml" }
        }
    }

    local {
        process.executor = 'local'
    }

    // Scaffolding for nf-test (see tests/ and nf-test.config) — small resource ceilings
    // suitable for CI runners. No stub fixtures are bundled yet; see README.md "Testing".
    test {
        singularity.enabled    = true
        singularity.autoMounts = true
        params.threads = 2
    }
}

// sensible defaults if no executor profile chosen
process.executor = 'local'

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------
timeline { enabled = true; file = "${params.output}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.output}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.output}/pipeline_info/trace.txt";      overwrite = true }
dag      { enabled = true; file = "${params.output}/pipeline_info/dag.html";       overwrite = true }
