nextflow_process {

    name "Test Process SEQTK_TELO"
    script "modules/local/assembly_qc.nf"
    process "SEQTK_TELO"

    test("Detects telomere-capped contigs for a single assembly") {

        when {
            params {
                sample = "test"
            }
            process {
                """
                // TODO(user): point at a stub assembly FASTA fixture (ideally with a
                // telomere-repeat-bearing contig to exercise the both-ends-capped metric)
                input[0] = [ "combined", file(params.test_data_dir + "/asm_test.fasta") ]
                """
            }
        }

        then {
            assert process.success
            // TODO(user): assert .telo.bed / .telo.both_ends.tsv content once stub data exists
        }
    }
}
