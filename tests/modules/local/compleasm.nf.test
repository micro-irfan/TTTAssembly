// Scaffolding only — no fixtures yet. TODO(user): add a stub assembly FASTA under
// tests/data/ and wire it in below, then fill in the real assertions.
// Conda-only workflow (see CLAUDE.md §10) — run with: nf-test test --profile conda <this file>

nextflow_process {

    name "Test Process COMPLEASM"
    script "modules/local/assembly_qc.nf"
    process "COMPLEASM"

    test("Runs gene-completeness assessment for a single assembly") {

        when {
            params {
                sample             = "test"
                compleasm_lineage  = "bacteria"   // small/fast lineage for a test fixture
            }
            process {
                """
                // TODO(user): point at a stub assembly FASTA fixture
                input[0] = [ "combined", file(params.test_data_dir + "/asm_test.fasta") ]
                """
            }
        }

        then {
            assert process.success
            // TODO(user): assert the compleasm report directory contents once stub data exists
        }
    }
}
